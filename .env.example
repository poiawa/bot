# Application
NODE_ENV=production
APP_NAME=VPN Bot
APP_URL=https://bot.example.com
APP_PORT=3000
APP_SECRET=generate-a-secure-64-char-secret-here

# Docker service passwords (generated by scripts/install.sh if empty)
DB_PASSWORD=change-me-securely
REDIS_PASSWORD=change-me-securely

# Telegram bot mode: 'webhook' or 'polling'
TELEGRAM_POLLING=false
APP_SECRET=generate-a-secure-64-char-secret-here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vpnbot

# Redis
REDIS_URL=redis://localhost:6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_SUPPORT_USERNAME=your_support_bot
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash

# Mini App
MINI_APP_URL=https://bot.example.com/mini-app
MINI_APP_SECRET=generate-another-secure-secret

# VPN Panels (Marzban Example)
MARZBAN_URL=http://localhost:8000
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=panel-password

# Payment Providers
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_CALLBACK_URL=https://bot.example.com/api/payments/zarinpal/callback

AQAYEPARDAKHT_MERCHANT_ID=your-merchant-id
AQAYEPARDAKHT_CALLBACK_URL=https://bot.example.com/api/payments/aqayepardakht/callback

# Card-to-Card Settings
CARD_TO_CARD_ENABLED=true
CARD_TO_CARD_NUMBER=1234-5678-9012-3456
CARD_TO_CARD_HOLDER_NAME="ACME VPN"

# Storage (S3 or Local)
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# STORAGE_S3_BUCKET=your-bucket
# STORAGE_S3_REGION=ir-tehran
# STORAGE_S3_ACCESS_KEY=your-key
# STORAGE_S3_SECRET_KEY=your-secret

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@bot.example.com

# Security
ENCRYPTION_KEY=32-byte-encryption-key-here
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# Backup
BACKUP_ENCRYPTION_KEY=backup-encryption-key
BACKUP_PATH=./backups

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
